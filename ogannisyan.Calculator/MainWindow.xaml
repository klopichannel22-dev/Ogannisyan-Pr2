<Window x:Class="ogannisyan.Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="500" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#f0f0f0">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="Display" Grid.Row="0" Grid.ColumnSpan="4" 
                 Margin="10" FontSize="36" TextAlignment="Right" 
                 VerticalContentAlignment="Center" IsReadOnly="True"
                 Background="White" BorderBrush="#ccc" Text="0"/>

        <Button Grid.Row="1" Grid.Column="0" Content="C" Margin="5,5,5,5" 
                Click="Button_Click" FontSize="20" FontWeight="Bold" Grid.ColumnSpan="2"/>
        <Button Grid.Row="1" Grid.Column="2" Content="+" Margin="5,5,5,5" 
                Click="Button_Click" FontSize="20" Background="#ff9500" Foreground="White" Grid.ColumnSpan="2"/>

        <Button Grid.Row="2" Grid.Column="0" Content="7" Margin="5" Click="Button_Click" FontSize="20"/>
        <Button Grid.Row="2" Grid.Column="1" Content="8" Margin="5" Click="Button_Click" FontSize="20"/>
        <Button Grid.Row="2" Grid.Column="2" Content="9" Margin="5" Click="Button_Click" FontSize="20"/>
        <Button Grid.Row="2" Grid.Column="3" Content="-" Margin="6,5,5,5" Click="Button_Click" FontSize="20" Background="#ff9500" Foreground="White"/>

        <Button Grid.Row="3" Grid.Column="0" Content="4" Margin="5" Click="Button_Click" FontSize="20"/>
        <Button Grid.Row="3" Grid.Column="1" Content="5" Margin="5" Click="Button_Click" FontSize="20"/>
        <Button Grid.Row="3" Grid.Column="2" Content="6" Margin="5" Click="Button_Click" FontSize="20"/>
        <Button Grid.Row="3" Grid.Column="3" Content="*" Margin="5" Click="Button_Click" FontSize="20" Background="#ff9500" Foreground="White"/>

        <Button Grid.Row="4" Grid.Column="0" Content="1" Margin="5" Click="Button_Click" FontSize="20"/>
        <Button Grid.Row="4" Grid.Column="1" Content="2" Margin="5" Click="Button_Click" FontSize="20"/>
        <Button Grid.Row="4" Grid.Column="2" Content="3" Margin="5" Click="Button_Click" FontSize="20"/>
        <Button Grid.Row="4" Grid.Column="3" Content="/" Margin="4,7,5,3" Click="Button_Click" FontSize="20" Background="#ff9500" Foreground="White"/>

        <Button Grid.Row="5" Grid.Column="0" Content="0" Margin="5" Grid.ColumnSpan="2" Click="Button_Click" FontSize="20"/>
        <Button Grid.Row="5" Grid.Column="2" Content="." Margin="5" Click="Button_Click" FontSize="20"/>
        <Button Grid.Row="5" Grid.Column="3" Content="^" Margin="4,6,4,5" Click="Button_Click" FontSize="20" Background="#ff9500" Foreground="White"/>

        <Button Grid.Row="6" Grid.Column="0" Content="=" Margin="5" Grid.ColumnSpan="4" Click="Button_Click" FontSize="20" Background="#2196F3" Foreground="White"/>
    </Grid>
</Window>